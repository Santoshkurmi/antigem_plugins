{
  // Retro games / 8-bit (pair with style retro8bit and look pixelate/scanlines).
  "pixel_dialog": {
    "about": "Game dialogue box: thick border, text typed on with blips, blinking ▼.",
    "params": {"name": "HERO", "text": "It's dangerous to go alone!", "w": 960, "h": 300},
    "layer": {"type": "group", "w": "{{w}}", "h": "{{h}}", "enter": {"preset": "flip_y", "duration": 0.25}, "layers": [
      {"type": "shape", "kind": "rect", "w": "100%", "h": "100%", "fill": "#000000", "stroke": "#ffffff", "stroke_width": 10, "radius": 4},
      {"type": "text", "text": "{{name}}", "font": "$font_mono", "size": 40, "color": "$accent", "align": "left", "anchor": "left", "x": 44, "y": 56},
      {"type": "text", "text": "{{text}}", "font": "$font_mono", "size": 42, "color": "#ffffff", "align": "left", "anchor": "top_left", "x": 44, "y": 96,
       "max_width": "88%", "max_height": "58%", "at": 0.25, "reveal": {"by": "char", "preset": "typewriter", "stagger": 0.04}, "sfx": {"src": "sfx:blip8", "volume": 0.3}},
      {"type": "text", "text": "▼", "font": "sans", "size": 34, "color": "#ffffff", "x": "94%", "y": "86%", "loop": {"preset": "flicker", "amp": 1, "freq": 2}}
    ]}
  },
  "pixel_title": {
    "about": "Arcade title: chunky text with hard drop shadow, slams down, flickers.",
    "params": {"text": "GAME OVER", "color": "$accent", "shadow": "$accent2", "size": 150},
    "layer": {"type": "text", "text": "{{text}}", "font": "$font_display", "size": "{{size}}", "color": "{{color}}", "uppercase": true, "stroke_width": 8, "stroke_color": "#000000",
              "letter_spacing": 6, "shadow": {"blur": 0, "dx": 12, "dy": 12, "opacity": 1, "color": "{{shadow}}"},
              "enter": {"preset": "drop", "duration": 0.6}, "sfx": {"src": "sfx:power8", "volume": 0.5}}
  },
  "press_start": {
    "about": "Blinking PRESS START prompt.",
    "params": {"text": "PRESS START", "color": "#ffffff", "size": 56},
    "layer": {"type": "text", "text": "{{text}}", "font": "$font_mono", "size": "{{size}}", "color": "{{color}}", "letter_spacing": 6,
              "loop": {"preset": "flicker", "amp": 1, "freq": 1.6}}
  },
  "score_counter": {
    "about": "Arcade SCORE readout that counts up. Anchored left.",
    "params": {"label": "SCORE", "to": 12500, "dur": 1.5},
    "layer": {"type": "group", "w": 600, "h": 80, "anchor": "left", "camera": false, "layers": [
      {"type": "text", "text": "{{label}}", "font": "$font_mono", "size": 46, "color": "$accent", "align": "left", "anchor": "left", "x": 0, "y": 40},
      {"type": "counter", "from": 0, "to": "{{to}}", "format": "{:07.0f}", "font": "$font_mono", "size": 46, "color": "#ffffff", "align": "left", "anchor": "left",
       "x": 210, "y": 40, "count": {"duration": "{{dur}}", "ease": "linear"}, "sfx": {"src": "sfx:coin8", "volume": 0.4}}
    ]}
  },
  "health_bar": {
    "about": "Segmented health/XP bar that drains in steps from full to `value` (0–1).",
    "params": {"label": "HP", "value": 0.3, "color": "#30d158", "w": 640},
    "layer": {"type": "group", "w": "{{w}}", "h": 80, "anchor": "left", "layers": [
      {"type": "text", "text": "{{label}}", "font": "$font_mono", "size": 44, "color": "#ffffff", "align": "left", "anchor": "left", "x": 0, "y": 40},
      {"type": "shape", "kind": "rect", "w": "80%", "h": 50, "x": "58%", "y": 40, "fill": "#000000", "stroke": "#ffffff", "stroke_width": 6},
      {"type": "group", "w": "78%", "h": 38, "x": "58%", "y": 40, "animate": {"crop_right": [[0.3, 0], [1.3, "{{= 1 - value }}", "steps(8)"]]}, "layers": [
        {"type": "shape", "kind": "rect", "w": "100%", "h": "100%", "fill": "{{color}}"}]}
    ]}
  }
}
