{
  // Photo and cut-out frames. "src" is your image (path relative to the project or assets/).
  "polaroid": {
    "about": "Instant photo: white frame, image, handwritten caption; drops in tilted.",
    "params": {"src": "photo.jpg", "caption": "", "rotation": -4, "w": 520, "focus": [0.5, 0.5]},
    "layer": {"type": "group", "w": 520, "h": 610, "scale": 1, "rotation": "{{rotation}}", "enter": "drop", "shadow": {"blur": 26, "dy": 14, "opacity": 0.4},
      "sfx": {"src": "sfx:shutter", "volume": 0.4}, "layers": [
      {"type": "shape", "kind": "rect", "w": 520, "h": 610, "radius": 4, "fill": "#fbfaf6"},
      {"type": "image", "src": "{{src}}", "w": 470, "h": 450, "fit": "cover", "focus": "{{focus}}", "y": 254},
      {"type": "text", "text": "{{caption}}", "font": "$font_hand", "size": 44, "color": "#222222", "y": 540, "max_width": 470}
    ]}
  },
  "evidence_photo": {
    "about": "Polaroid pinned to a board with a red pin (true crime / investigation boards).",
    "params": {"src": "photo.jpg", "caption": "", "rotation": 3, "pin": "#d62828"},
    "layer": {"type": "group", "w": 520, "h": 650, "rotation": "{{rotation}}", "enter": "drop", "shadow": {"blur": 22, "dy": 12, "opacity": 0.45},
      "sfx": {"src": "sfx:shutter", "volume": 0.4}, "layers": [
      {"type": "shape", "kind": "rect", "w": 500, "h": 600, "y": 340, "radius": 3, "fill": "#f7f4ec"},
      {"type": "image", "src": "{{src}}", "w": 450, "h": 440, "fit": "cover", "y": 300, "filter": {"saturation": 0.75, "contrast": 1.1}},
      {"type": "text", "text": "{{caption}}", "font": "$font_hand", "size": 40, "color": "#222222", "y": 585, "max_width": 450},
      {"type": "shape", "kind": "circle", "size": 40, "y": 48, "fill": {"colors": ["#ff8a8a", "{{pin}}"], "radial": true}, "shadow": {"blur": 6, "dy": 6, "opacity": 0.5}}
    ]}
  },
  "print_photo": {
    "about": "Photo print with thin white border and soft shadow.",
    "params": {"src": "photo.jpg", "w": 640, "rotation": 2},
    "layer": {"type": "image", "src": "{{src}}", "w": "{{w}}", "rotation": "{{rotation}}", "border": {"width": 14, "color": "#fbfaf6"},
              "shadow": {"blur": 24, "dy": 14, "opacity": 0.4}, "enter": "drop"}
  },
  "photo_card": {
    "about": "Rounded photo card with shadow (modern/clean).",
    "params": {"src": "photo.jpg", "w": 720, "h": 480, "radius": 32},
    "layer": {"type": "image", "src": "{{src}}", "w": "{{w}}", "h": "{{h}}", "fit": "cover", "radius": "{{radius}}",
              "shadow": {"blur": 40, "dy": 22, "opacity": 0.45}, "enter": {"preset": "pop", "from": 0.85}}
  },
  "sticker": {
    "about": "Cut-out with a thick white sticker border and small shadow (explainers, Vox collage). Use transparent PNGs.",
    "params": {"src": "cutout.png", "h": 520, "rotation": -3, "border": "#ffffff", "width": 14},
    "layer": {"type": "image", "src": "{{src}}", "h": "{{h}}", "rotation": "{{rotation}}", "outline": {"width": "{{width}}", "color": "{{border}}"},
              "shadow": {"blur": 14, "dy": 8, "opacity": 0.35}, "enter": {"preset": "pop", "duration": 0.45}, "loop": {"preset": "float", "amp": 6},
              "sfx": {"src": "sfx:pop", "volume": 0.45}}
  },
  "paper_cutout": {
    "about": "Cut-out with a cream paper border, slight hand-made wobble (documentary collage).",
    "params": {"src": "cutout.png", "h": 520, "rotation": 2},
    "layer": {"type": "image", "src": "{{src}}", "h": "{{h}}", "rotation": "{{rotation}}", "outline": {"width": 18, "color": "$paper"},
              "shadow": {"blur": 10, "dy": 6, "opacity": 0.4}, "enter": "slide_up", "loop": {"preset": "boil", "amp": 1.2, "fps": 6}}
  },
  "taped_photo": {
    "about": "Photo stuck on with two strips of tape.",
    "params": {"src": "photo.jpg", "w": 600, "rotation": -2},
    "layer": {"type": "group", "w": "{{w}}", "h": 700, "rotation": "{{rotation}}", "enter": "drop", "layers": [
      {"type": "image", "src": "{{src}}", "w": "{{w}}", "border": {"width": 10, "color": "#fbfaf6"}, "shadow": {"blur": 18, "dy": 10, "opacity": 0.35}},
      {"type": "shape", "kind": "rect", "w": 170, "h": 52, "x": "8%", "y": "26%", "rotation": -35, "fill": "#f3e7a8b0"},
      {"type": "shape", "kind": "rect", "w": 170, "h": 52, "x": "92%", "y": "26%", "rotation": 35, "fill": "#f3e7a8b0"}
    ]}
  }
}
