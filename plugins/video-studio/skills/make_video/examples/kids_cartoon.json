     "y": "68%",
     "at": 4.8,
     "sfx": "sfx:pop"
    },
    {
     "type": "particles",
     "kind": "confetti",
     "count": 60,
     "at": 4.8,
     "sfx": "sfx:success"
    }
   ],
   "camera": {
    "preset": "still",
    "punches": [
     {
      "at": 1.6
     },
     {
      "at": 2.9
     },
     {
      "at": 4.2
