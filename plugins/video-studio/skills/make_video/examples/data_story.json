{
  // Data story in 16:9 with a reusable stat template. No assets needed.
  "aspect": "16:9",
  "fps": 30,
  "background": {"colors": ["#0f172a", "#111827"], "angle": 90},
  "transition": {"type": "slide_left", "duration": 0.45},
  "look": {"vignette": 0.3},
  "defs": {
    "stat": {
      "params": {"value": 0, "suffix": "", "label": "", "color": "#38bdf8"},
      "layer": {
        "type": "group", "w": 520, "h": 300, "enter": "rise",
        "layers": [
          {"type": "counter", "to": "{{value}}", "suffix": "{{suffix}}", "font": "display", "size": 150, "color": "{{color}}", "y": 110,
           "count": {"duration": 1.4}},
          {"type": "text", "text": "{{label}}", "font": "sans", "size": 40, "color": "#cbd5e1", "y": 235}
        ]
      }
    }
  },
  "scenes": [
    {
      "id": "title", "duration": 3,
      "layers": [
        {"type": "text", "text": "The year in *numbers*", "font": "display", "size": 140, "highlight": "#38bdf8",
         "reveal": {"by": "word", "preset": "slide_up", "stagger": 0.1}, "sfx": "sfx:whoosh"},
        {"type": "shape", "kind": "line", "from": ["30%", "62%"], "to": ["70%", "62%"], "stroke": "#38bdf8", "stroke_width": 6,
         "at": 0.6, "animate": {"progress": [[0, 0], [0.8, 1, "out_expo"]]}}
      ]
    },
    {
      "id": "stats", "duration": 4,
      "layers": [
        {"use": "stat", "with": {"value": 128, "label": "projects shipped"}, "x": "20%", "y": "50%", "at": 0.1, "sfx": "sfx:pop"},
        {"use": "stat", "with": {"value": 94, "suffix": "%", "label": "on time", "color": "#4ade80"}, "x": "50%", "y": "50%", "at": 0.35, "sfx": "sfx:pop"},
        {"use": "stat", "with": {"value": 12, "suffix": "k", "label": "new users", "color": "#f472b6"}, "x": "80%", "y": "50%", "at": 0.6, "sfx": "sfx:pop"}
      ]
    },
    {
      "id": "chart", "duration": 4.5,
      "layers": [
        {"type": "text", "text": "Monthly active users (k)", "font": "display", "size": 72, "slot": "title", "enter": "fade"},
        {"type": "chart", "kind": "line", "values": [2, 3.1, 3.4, 5.2, 6.8, 8.9, 12], "labels": ["Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
         "colors": ["#38bdf8"], "format": "{:.1f}", "slot": "hero", "at": 0.3, "grow": {"duration": 2.2, "stagger": 0, "ease": "in_out_sine"}},
        {"type": "text", "text": "6x growth", "font": "display", "size": 90, "color": "#facc15", "x": "50%", "y": "83%", "at": 2.6,
         "enter": {"preset": "stamp", "angle": -6}, "rotation": -6, "sfx": "sfx:hit"}
      ]
    }
  ]
}
