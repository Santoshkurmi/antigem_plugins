    "inspect_pe_load_config",
    "inspect_pe_resources",
    "project_managed_application_graph",
    "verify_managed_native_boundaries"
   ]
  },
  {
   "id": "decompiler",
   "name": "Decompiler session",
   "description": "Functions, pseudo-code, strings, cross references and annotations of an opened binary. Needs a decompiler engine (Ghidra, IDA, Hopper or Kuna), which AntiGem does not install.",
   "builtin": true,
   "tools": [
